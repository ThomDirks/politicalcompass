      ],
      "t": "t10"
    },
    "cli_amb": {
      "vars": [
        "climate_change",
        "environment"
      ],
      "t": "t10",
      "combine": "first"
    },
    "cli_nat": {
      "vars": [
        "environment"
      ],
      "t": "t10"
    },
    "dem_trust": {
      "vars": [
        "antielite_salience"
      ],
      "t": "t10"
    },
    "dem_direct": {
      "vars": [
        "people_vs_elite"
      ],
      "t": "t10"
    },
    "dem_courts": {
      "vars": [
        "judicial_independence",
        "executive_power"
      ],
      "t": "t10",
      "combine": "mean"
    },
    "dem_central": {
      "vars": [
        "regions"
      ],
      "t": "t10"
    }
  },
  "proxies": {
    "ECO": {
      "var": "lrecon",
      "t": "t10",
      "note": "Overall economic left/right"
    },
    "SOC": {
      "var": "galtan",
      "t": "t10",
      "note": "GAL-TAN; also captures authority and nationalism"
    }
  },
  "notes": [
    "dem_trust uses anti-elite salience (how much a party uses anti-elite rhetoric), which is a proxy for its position.",
    "int_def uses eu_russia (defend against Russia vs. trade and diplomacy with Russia), only available in 2024.",
    "cli_nat uses general environmental sustainability vs. growth.",
    "dem_courts combines judicial independence and executive power (horizontal accountability). CHES executive_power is not mapped to lib_emerg, which is about emergency powers and restrictions on assembly."
  ],
